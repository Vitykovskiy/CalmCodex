{
  "name": "calmcodex",
  "displayName": "CalmCodex",
  "publisher": "local-calmcodex",
  "description": "Спокойная формулировка и подготовка промпта при отправке в Codex.",
  "version": "2.2.0",
  "engines": {
    "vscode": "^1.96.2"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "calmCodex.preview",
        "title": "Переформулировать для Codex"
      },
      {
        "command": "calmCodex.optimize",
        "title": "Подготовить промпт для Codex"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "calmCodex.preview",
          "when": "false"
        },
        {
          "command": "calmCodex.optimize",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "calmCodex.preview",
          "when": "calmCodexComposer && (webviewId == 'chatgpt.sidebarView' || webviewId == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.panelView' || webviewId == 'chatgpt.conversationEditor')",
          "group": "navigation@1"
        },
        {
          "command": "calmCodex.optimize",
          "when": "calmCodexComposer && (webviewId == 'chatgpt.sidebarView' || webviewId == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.panelView' || webviewId == 'chatgpt.conversationEditor')",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "CalmCodex",
      "properties": {
        "calmCodex.rewriteOnSend": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Обрабатывать текст перед обычной отправкой в Codex. Контекстное меню работает независимо."
        },
        "calmCodex.mode": {
          "type": "string",
          "enum": ["rewrite", "prompt"],
          "enumDescriptions": [
            "Убрать эмоциональный шум, сохранив смысл и тип реплики.",
            "Сформулировать задачу для Codex: цель, контекст, ограничения и ожидаемый результат."
          ],
          "default": "rewrite",
          "scope": "application",
          "description": "Режим обработки перед отправкой. Команды контекстного меню выбирают свой режим."
        }
      }
    }
  },
  "files": [
    "composer.mjs",
    "extension.cjs",
    "host.cjs",
    "install-adapter.cjs",
    "engine/**",
    "README.md"
  ]
}
