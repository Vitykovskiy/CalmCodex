{
  "name": "calmcodex",
  "displayName": "CalmCodex",
  "publisher": "local-calmcodex",
  "description": "Спокойная формулировка при отправке и в контекстном меню поля Codex.",
  "version": "2.1.0",
  "engines": {
    "vscode": "^1.96.2"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "calmCodex.preview",
        "title": "Переформулировать для Codex"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "calmCodex.preview",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "calmCodex.preview",
          "when": "calmCodexComposer && (webviewId == 'chatgpt.sidebarView' || webviewId == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.panelView' || webviewId == 'chatgpt.conversationEditor')",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "CalmCodex",
      "properties": {
        "calmCodex.rewriteOnSend": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Переформулировать текст перед обычной отправкой в Codex. Контекстное меню работает независимо."
        }
      }
    }
  },
  "files": [
    "composer.mjs",
    "extension.cjs",
    "host.cjs",
    "install-adapter.cjs",
    "engine/**",
    "README.md"
  ]
}
